{
  "db_path": "/var/lib/fan-controller/fan.db",
  "listen_host": "0.0.0.0",
  "listen_port": 8780,
  "socket_path": "/run/fan-controller/ctl.sock",
  "socket_group": "fanctl",
  "secrets_dir": "/etc/fan-controller/secrets",
  "dry_run": true,
  "poll_s": 5.0,
  "ipmi_every_s": 30.0,
  "offset_read_every_s": 60.0,
  "watchdog_every_s": 60.0,
  "prune_every_s": 3600.0,
  "nvidia_timeout_s": 10.0,
  "ipmi_timeout_s": 15.0,
  "racadm_timeout_s": 10.0,
  "racadm_set_budget_s": 25.0,
  "blind_idle_power_w": 235.0,
  "blind_power_above_w": 50.0,
  "blind_hold_s": 30.0,
  "nvidia_fail_polls": 3,
  "api_retry_s": 60.0,
  "llama_health_url": "http://127.0.0.1:8080/health",
  "timezone": "EET",
  "backup_target": "",
  "backup_key": "/etc/fan-controller/secrets/docks_ed25519",
  "backup_known_hosts": "/etc/fan-controller/known_hosts",
  "backup_dir": "/var/lib/fan-controller/backup"
}
